{
  "name": "@swmansion/gesture-handler-dom-engine",
  "version": "0.0.0",
  "private": true,
  "description": "DOM gesture recognition engine shared by react-native-gesture-handler (RNW web / Windows compat) and react-gesture-handler",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "ts-check": "yarn tsc --noEmit",
    "lint:rn-free": "node ../../scripts/check-rn-free.js src",
    "build": "yarn tsc -p tsconfig.build.json --noEmit && bob build",
    "lint-js": "eslint --ext '.js,.ts,.tsx' src/ && yarn prettier --check './src/**/*.{js,jsx,ts,tsx}'"
  },
  "dependencies": {
    "@swmansion/gesture-handler-core": "workspace:~"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "3.3.3",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "~6.0.3"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "README.md"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
