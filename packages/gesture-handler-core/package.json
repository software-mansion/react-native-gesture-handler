{
  "name": "@swmansion/gesture-handler-core",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-agnostic core of gesture-handler: v3 hooks, detector orchestration, types and the platform port",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "ts-check": "yarn tsc --noEmit",
    "lint:rn-free": "node ../../scripts/check-rn-free.js src",
    "build": "yarn tsc -p tsconfig.build.json --noEmit && bob build"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.40.13",
    "typescript": "~6.0.3"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "README.md"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
